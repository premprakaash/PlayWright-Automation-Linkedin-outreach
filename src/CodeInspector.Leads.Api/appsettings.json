{
  "ConnectionStrings": {
    "LeadsDatabase": "Host=localhost;Port=5432;Database=codeinspector;Username=codeinspector;Password=codeinspector;Search Path=leads,public"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "CodeInspector.Leads",
      "Audience": "CodeInspector.Leads.Client",
      "Key": "development-only-change-me-32-characters-min"
    }
  },
  "Import": {
    "MaxFileSizeBytes": 5242880,
    "MaxRows": 10000
  },
  "DailyProcessing": {
    "BatchSize": 100,
    "MaxAttempts": 5,
    "MaxConcurrency": 4
  },
  "Browser": {
    "Headless": true,
    "NavigationTimeoutMs": 30000,
    "MaxPages": 3,
    "MaxResponseBytes": 512000,
    "AllowedDomains": []
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
